# Copy this file to .env for local overrides. Never commit credentials.
QUANT_APP_ENV=development
QUANT_LOG_LEVEL=INFO
QUANT_DATA_DIR=data
QUANT_ALPHA_VANTAGE_API_KEY=
QUANT_SEC_USER_AGENT=qlib_quant/0.1 your-email@example.com
QUANT_TELEGRAM_BOT_TOKEN=
QUANT_TELEGRAM_CHAT_ID=

# Optional Alpaca intraday provider; configure only after choosing that source.
QUANT_ALPACA_API_KEY=
QUANT_ALPACA_SECRET_KEY=
